{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:APOLLO_MODEL:opencode/deepseek-v4-flash-free}",
  "small_model": "{env:APOLLO_SMALL_MODEL:opencode/north-mini-code-free}",
  "default_agent": "apollo-ultra",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com"
      }
    },
    "zhipuai": {
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/paas/v4"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": { "context": 128000, "output": 8192 }
        },
        "glm-5.2-flash": {
          "name": "GLM-5.2-Flash",
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    }
  },
  "agent": {
    "apollo-ultra": {
      "description": "APOLLO ULTRA - Primary command & control agent (default)",
      "mode": "primary",
  "model": "{env:APOLLO_MODEL:zhipuai/glm-5.2}",
      "temperature": 0.0,
      "permission": {
        "bash": "allow", "read": "allow", "edit": "allow", "write": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow", "todowrite": "allow", "skill": "allow", "question": "allow",
        "external_directory": "allow"
      },
      "color": "#FF0000"
    },

    "apollo-big-pickle": {
      "description": "APOLLO ULTRA on big-pickle (free, high capacity)",
      "mode": "primary", "model": "opencode/big-pickle", "temperature": 0.0,
      "permission": { "bash": "allow", "read": "allow", "edit": "allow", "write": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow", "todowrite": "allow", "skill": "allow", "question": "allow",
        "external_directory": "allow" },
      "color": "#FF5733"
    },
